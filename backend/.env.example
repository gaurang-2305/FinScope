# FinScope Environment Variables
# Copy this to .env and fill in real values. Never commit .env itself.

# Database — SQLite for local dev, Postgres for production
DATABASE_URL=sqlite:///./finscope.db
# DATABASE_URL=postgresql://user:password@host:5432/finscope

# Google OAuth 2.0 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT signing secret — generate a strong random value for production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-random-string

# Anthropic API key (for LLM extraction + RAG chat)
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR — a real contact email is required by SEC fair-access policy
SEC_USER_AGENT_EMAIL=your-email@example.com

# Frontend origin — used for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# Backend public URL — used for OAuth redirect
BACKEND_URL=http://localhost:8000
